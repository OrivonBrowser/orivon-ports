// The composed bridge, byte for byte what the browser is served, in a fresh
// realm per test. The kit's own behaviours are covered in src/bridge/; what
// belongs here is this app's roster and its hand-written members.
import { describe, expect, it } from 'vitest'
import { bridgeSourceFor, runBridge } from '../../../src/testing/bridge-harness.ts'

const source = await bridgeSourceFor('{{id}}')

// Every `window.{{bridgeName}}.<name>` call site in the clone's renderer.
// `orivon-port recon <clone>` lists them.
const MEMBERS: readonly string[] = []

describe('the roster', () => {
  it('installs exactly the members upstream calls, on window.{{bridgeName}}', () => {
    const { bridge, sandbox } = runBridge(source)
    expect(Object.keys(bridge).sort()).toEqual([...MEMBERS].sort())
    expect(sandbox.window['{{bridgeName}}']).toBe(bridge)
  })
})
