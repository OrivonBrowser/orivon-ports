{
  "id": "{{id}}",
  "name": "{{name}}",
  "port": {{port}},
  "eth": "{{eth}}",
  "hint": { "tier": 2, "name": "{{name}}", "officialUrl": "https://REPLACE-WITH-UPSTREAM-DOWNLOADS/" },

  "upstream": {
    "repo": "https://github.com/OWNER/REPO.git",
    "ref": "0000000000000000000000000000000000000000",
