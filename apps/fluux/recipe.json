    "output": "apps/fluux/dist"
  },

  "manifest": "orivon.json",
  "hooks": "hooks.mjs",
  "extraFiles": [
    { "from": "LICENSE", "to": "LICENSE" }
  ],
  "icon": "apps/fluux/public/icon-192.png"
