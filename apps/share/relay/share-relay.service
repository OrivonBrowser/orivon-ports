[Unit]
Description=Orivon Share circuit relay (orivon-ports apps/share/relay)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/node --max-old-space-size=200 /opt/share-relay/relay.mjs
Environment=STATE_DIR=/var/lib/share-relay LISTEN=/ip4/0.0.0.0/tcp/4003 ANNOUNCE=/ip4/152.228.138.30/tcp/4003
DynamicUser=yes
User=share-relay
StateDirectory=share-relay
MemoryMax=300M
CPUQuota=100%
Nice=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
TasksMax=128
LimitNOFILE=2048
TimeoutStopSec=15
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
