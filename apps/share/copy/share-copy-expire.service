[Unit]
Description=Orivon Share copy: end the copies whose month is over
After=network-online.target ipfs.service
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=15min
MemoryMax=150M
ExecStart=/usr/local/bin/node /opt/share-copy/copy/expire.mjs
EnvironmentFile=/etc/share-copy/secrets.env
Environment=STATE_DIR=/var/lib/share-copy
DynamicUser=yes
User=share-copy
StateDirectory=share-copy
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
TasksMax=64
LimitNOFILE=1024
