[Unit]
Description=Orivon Share copy on Orivon's server (orivon-ports apps/share/copy)
After=network-online.target ipfs.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/node --max-old-space-size=200 /opt/share-copy/copy/copy.mjs
EnvironmentFile=/etc/share-copy/secrets.env
Environment=PORT=8093 STATE_DIR=/var/lib/share-copy
DynamicUser=yes
User=share-copy
StateDirectory=share-copy
MemoryMax=300M
Nice=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
TasksMax=64
LimitNOFILE=1024
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
