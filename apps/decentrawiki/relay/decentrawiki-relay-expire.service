[Unit]
Description=DecentraWiki free pinning: end the pins whose month is over
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/node /opt/decentrawiki-relay/relay/expire.mjs
EnvironmentFile=/etc/decentrawiki-relay/secrets.env
Environment=STATE_DIR=/var/lib/decentrawiki-relay
DynamicUser=yes
User=decentrawiki-relay
StateDirectory=decentrawiki-relay
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
