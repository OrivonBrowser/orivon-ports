[Unit]
Description=DecentraWiki free pinning: put the kept IPNS names back on the network
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=2h
MemoryMax=150M
ExecStart=/usr/local/bin/node /opt/decentrawiki-relay/relay/republish.mjs
Environment=STATE_DIR=/var/lib/decentrawiki-relay KUBO_RPC=http://127.0.0.1:5001
DynamicUser=yes
User=decentrawiki-relay
StateDirectory=decentrawiki-relay
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
TasksMax=64
LimitNOFILE=1024
