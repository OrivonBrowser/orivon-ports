{
  "orivonApiVersion": 0,
  "id": "eth.orivonstack.og",
  "name": "OG names",
  "version": "0.1.2",
  "domain": "og.orivonstack.eth",
  "entry": "index.html",
  "consentGranularity": "per-capability",
  "capabilities": {
